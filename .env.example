# Copy to .env for local runs. The Makefile falls back to these same defaults,
# so a fresh clone works without creating this file at all.

DATABASE_URL=postgres://facility:facility@localhost:5433/facility?sslmode=disable
HTTP_ADDR=:8080

# Shared secret for the inbound webhook HMAC signature. The service refuses to
# start with the placeholder value in a non-development environment.
HMAC_SECRET=dev-secret-do-not-use-in-production

# sync  — ledger entry and balance update commit inside the request (read-your-writes)
# async — request durably records the payment; a worker pool applies it
APPLY_MODE=sync

LOG_LEVEL=info
