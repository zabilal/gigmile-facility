# Copy to .env for local runs. The Makefile falls back to these same defaults,
# so a fresh clone works without creating this file at all.

DATABASE_URL=postgres://facility:facility@localhost:5433/facility?sslmode=disable
HTTP_ADDR=:8080

# Webhook HMAC secret. The service refuses to start with this placeholder
# outside development.
HMAC_SECRET=dev-secret-do-not-use-in-production

# sync  — ledger entry and balance commit in the request (read-your-writes)
# async — the request records durably; a worker pool applies it
APPLY_MODE=sync

LOG_LEVEL=info
